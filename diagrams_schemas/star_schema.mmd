---
title: DeservEat - star schema (dw)
---
erDiagram
    DIM_USER ||--o{ FACT_CALORIE_BURN : "version valid at requested_at"
    DIM_RECIPE ||--o{ FACT_CALORIE_BURN : "dish"
    DIM_RESTAURANT ||--o{ FACT_CALORIE_BURN : "restaurant"
    DIM_ACTIVITY ||--o{ FACT_CALORIE_BURN : "activity"
    DIM_DATE ||--o{ FACT_CALORIE_BURN : "day (Lyon time)"
    DIM_LANDMARK |o--o{ FACT_CALORIE_BURN : "0..1 landmark (NULL = none)"
    DIM_ITINERARY ||--|| FACT_CALORIE_BURN : "1:1"

    FACT_CALORIE_BURN {
        int calorie_burn_key PK
        int user_key FK "dim_user"
        int recipe_key FK "dim_recipe"
        int restaurant_key FK "dim_restaurant"
        int activity_key FK "dim_activity"
        int landmark_key FK "dim_landmark, nullable"
        int itinerary_key FK,UK "dim_itinerary, 1:1"
        int date_key FK "dim_date, YYYYMMDD"
        int kcal_to_burn "one serving, > 0"
        numeric duration_min "60 x kcal / (MET x kg)"
        numeric distance_km "speed x duration / 60"
        timestamptz requested_at
    }

    DIM_USER {
        int user_key PK
        text user_id "business key"
        numeric weight_kg "30-250"
        timestamptz valid_from
        timestamptz valid_to "9999-12-31 if current"
        boolean is_current
    }

    DIM_RECIPE {
        int recipe_key PK
        int source_id UK "recipe_id"
        text title
        int kcal_per_serving "1-3000"
        int servings
        int total_kcal
        text category "food.com tags"
        text ingredients
        text recipe_url
    }

    DIM_RESTAURANT {
        int restaurant_key PK
        bigint source_id UK "md5(name|lat|lng)"
        text restaurant_name
        text food_type
        double lat
        double lng
        geography geom "Point 4326"
        numeric overall_rating "0-5"
        text district
    }

    DIM_LANDMARK {
        int landmark_key PK
        text source_id UK "Merimee ref"
        text building_name
        text address
        text commune
        char insee_code "58 Metropole codes"
        double lat
        double lon
        geography geom "Point 4326"
    }

    DIM_ACTIVITY {
        int activity_key PK "Compendium code"
        text activity_name UK "e.g. Moderate Walk"
        int intensity "1-3"
        numeric met_value
        numeric speed_kmh
    }

    DIM_DATE {
        int date_key PK "YYYYMMDD"
        date full_date UK
        int day_of_week "ISO, 1 = Monday"
        text day_name
        int month
        int year
        boolean is_weekend
    }

    DIM_ITINERARY {
        int itinerary_key PK
        text start_type "restaurant / user_location"
        geography start_point "user position rounded ~200 m"
        geography end_point "landmark, or start (loop)"
        jsonb route_steps "NULL for now"
    }
