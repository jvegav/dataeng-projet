---
title: "Grain: one row per dish whose calories are to be burned, for one user at one moment, with one restaurant, one activity, one itinerary and 0..1 landmark"
---
erDiagram
    dim_itinerary ||--|| fact_calorie_burn : "1:1"
    dim_user ||--o{ fact_calorie_burn : "version valid at requested_at"
    dim_date ||--o{ fact_calorie_burn : ""
    dim_landmark |o--o{ fact_calorie_burn : "0..1"
    dim_restaurant ||--o{ fact_calorie_burn : ""
    dim_activity ||--o{ fact_calorie_burn : ""
    dim_recipe ||--o{ fact_calorie_burn : ""

    fact_calorie_burn {
        INT calorie_burn_key PK
        INT recipe_key FK
        INT activity_key FK
        INT landmark_key FK "NULL = no landmark"
        INT user_key FK
        INT restaurant_key FK
        INT date_key FK
        INT itinerary_key FK "UNIQUE (1:1)"
        INT kcal_to_burn
        NUMERIC(7,2) distance_km
        NUMERIC(7,1) duration_min
        TIMESTAMPTZ requested_at
    }

    dim_itinerary["dim_itinerary (entity)"] {
        INT itinerary_key PK
        TEXT start_type "restaurant / user_location"
        GEOGRAPHY(Point,4326) start_point "user position rounded ~200 m"
        GEOGRAPHY(Point,4326) end_point "landmark, or start (loop)"
        JSONB route_steps "NULL for now"
    }

    dim_user["dim_user (SCD2)"] {
        INT user_key PK
        TEXT user_id
        NUMERIC(5,1) weight_kg
        TIMESTAMPTZ valid_from
        TIMESTAMPTZ valid_to
        BOOLEAN is_current
    }

    dim_date["dim_date (static)"] {
        INT date_key PK
        DATE full_date
        INT day_of_week
        TEXT day_name
        INT month
        INT year
        BOOLEAN is_weekend
    }

    dim_landmark["dim_landmark (SCD1)"] {
        INT landmark_key PK
        TEXT source_id
        TEXT building_name
        TEXT address
        TEXT commune
        CHAR(5) insee_code
        DOUBLE_PRECISION lat
        DOUBLE_PRECISION lon
        GEOGRAPHY(Point,4326) geom
    }

    dim_restaurant["dim_restaurant (SCD1)"] {
        INT restaurant_key PK
        BIGINT source_id
        TEXT restaurant_name
        TEXT food_type
        DOUBLE_PRECISION lat
        DOUBLE_PRECISION lng
        GEOGRAPHY(Point,4326) geom
        NUMERIC(3,2) overall_rating
        TEXT district
    }

    dim_activity["dim_activity (static)"] {
        INT activity_key PK
        TEXT activity_name
        INT intensity
        NUMERIC(4,2) met_value
        NUMERIC(5,2) speed_kmh
    }

    dim_recipe["dim_recipe (SCD1)"] {
        INT recipe_key PK
        INT source_id
        TEXT title
        INT total_kcal
        INT kcal_per_serving
        TEXT category
        TEXT ingredients
        TEXT recipe_url
        INT servings
    }
