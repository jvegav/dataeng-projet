# Copy to .env (never commit .env) and change the passwords.
# Use letters and digits only in passwords: they are put inside connection URLs.

# Warehouse (PostGIS)
POSTGRES_USER=deserveat
POSTGRES_PASSWORD=change_me_dw
POSTGRES_DB=deserveat
POSTGRES_PORT=5432

# Airflow metadata database (created on the same server at the first start)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
AIRFLOW_DB_NAME=airflow

# Airflow web UI
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_SECRET_KEY=change_me_random_string

# Linux only: your user id (`id -u`) so files written in data/ belong to you. Keep 50000 on Windows/macOS.
AIRFLOW_UID=50000

# true = the pipeline reads the versioned offline sample (data/sample/); false = the real files in data/raw/
SAMPLE=true
